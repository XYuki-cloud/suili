<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="3dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical">
        <TextView android:id="@id/previous" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="18sp" android:includeFontPadding="false" android:textColor="#477766" android:contentDescription="上一页"/>
        <TextView android:id="@id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="随历 · 月历" android:textColor="#233B31" android:textStyle="bold" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@id/mode" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="四周" android:textSize="10sp" android:includeFontPadding="false" android:textColor="#477766" android:contentDescription="切换月历与四周"/>
        <TextView android:id="@id/refresh" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textSize="16sp" android:includeFontPadding="false" android:textColor="#477766" android:contentDescription="刷新并同步"/>
        <TextView android:id="@id/next" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="18sp" android:includeFontPadding="false" android:textColor="#477766" android:contentDescription="下一页"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_weekdays" android:layout_width="match_parent" android:layout_height="12dp">
        <TextView android:id="@+id/widget_monday" style="@style/WeekDay" android:text="一"/><TextView android:id="@+id/widget_tuesday" style="@style/WeekDay" android:text="二"/><TextView android:id="@+id/widget_wednesday" style="@style/WeekDay" android:text="三"/><TextView android:id="@+id/widget_thursday" style="@style/WeekDay" android:text="四"/><TextView android:id="@+id/widget_friday" style="@style/WeekDay" android:text="五"/><TextView android:id="@+id/widget_saturday" style="@style/WeekDay" android:text="六"/><TextView android:id="@+id/widget_sunday" style="@style/WeekDay" android:text="日"/>
    </LinearLayout>
    <LinearLayout android:id="@id/weeks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
    <TextView android:id="@id/widget_footer" android:layout_width="match_parent" android:layout_height="21dp" android:gravity="center_vertical" android:text="本地日历" android:textColor="#62756B" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:visibility="gone"/>
</LinearLayout>
